# SOC SIEM — пример конфигурации
# Скопируйте этот файл в .env и заполните значения:
#   cp .env.example .env

# Порт и адрес веб-интерфейса
SOC_PORT=5050
SOC_HOST=0.0.0.0

# Путь к базе данных SQLite
SOC_DB_PATH=/opt/soc/soc.db

# Логин администратора
SOC_USERNAME=admin

# Пароль в виде SHA-256 хэша.
# Сгенерировать: python3 -c "import hashlib; print(hashlib.sha256(b'ВАШ_ПАРОЛЬ').hexdigest())"
SOC_PASSWORD_HASH=changeme_replace_with_hash

# Случайная строка для подписи сессий (любой набор символов, чем длиннее — тем лучше)
SOC_SECRET_KEY=replace-with-random-string-at-least-32-chars

# Порог очков угрозы для автоматической блокировки IP (по умолчанию: 15)
SOC_BLOCK_THRESHOLD=15

# Включить реальную блокировку через UFW: true / false
# false = только логировать, не блокировать (безопасный режим для теста)
SOC_UFW_BLOCKING=true

# Белый список IP через запятую — никогда не блокировать
# Добавьте свой домашний IP и IP локальной сети
SOC_WHITELIST=127.0.0.1,::1

# Rate limiting страницы входа
SOC_LOGIN_MAX_ATTEMPTS=5
SOC_LOGIN_WINDOW_SEC=600
